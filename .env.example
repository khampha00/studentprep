# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=studentprep_dev
POSTGRES_URL=jdbc:postgresql://localhost:5432/studentprep

# --- Redis ---
REDIS_HOST=localhost
REDIS_PASSWORD=studentprep_redis

# --- Storage (MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studentprep-assets

# --- Security ---
# Generate a random 256-bit key for production
JWT_SECRET=super_secret_jwt_key_for_local_development_only_do_not_use_in_prod
JWT_EXPIRATION_MS=900000

# --- Third Party APIs ---
# IMPORTANT: DO NOT commit your real keys. Copy this file to .env and paste them there.
LLM_API_KEY=your_llm_api_key_here
DOCLING_API_KEY=your_ocr_api_key_here
