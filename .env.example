# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=studentprep_dev
POSTGRES_URL=jdbc:postgresql://localhost:5433/studentprep

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=studentprep_redis

# --- Storage (MinIO / S3) ---
# Production MUST replace minioadmin credentials and set an externally reachable S3_PUBLIC_BASE_URL
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studentprep-assets

# --- Security & Auth ---
# Generate a random >=256-bit (32+ char) key for production; prod startup rejects this dev example key
JWT_SECRET=super_secret_jwt_key_for_local_development_only_do_not_use_in_prod
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Separate >=256-bit (32+ byte) secret for AES-256-GCM student credential vault encryption in prod
# Keep independent from JWT_SECRET so JWT signing keys can rotate without breaking stored PIN ciphertexts
# Optional in non-prod (falls back to dev default in application.yml); prod startup rejects this dev default
CREDENTIAL_ENCRYPTION_KEY=local_dev_credential_vault_key_change_in_prod

# Explicit bootstrap secret for ADMIN-001 (>=12 high-entropy chars required in prod; leave blank once bootstrapped)
ADMIN_BOOTSTRAP_SECRET=

# Comma-separated explicit trusted browser origins (wildcard '*' is forbidden)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set COOKIE_SECURE=true in HTTPS staging/production; false only for local HTTP dev
# (APP_COOKIE_SECURE is also supported as an alias override)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# --- Flyway ---
# Keep false in staging/production so migration checksums and schema state are never bypassed
FLYWAY_BASELINE_ON_MIGRATE=false

# --- Third Party APIs & Internal Services ---
# IMPORTANT: DO NOT commit your real keys. Copy this file to .env and configure local secrets there.
LLM_API_KEY=your_llm_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
DOCLING_PARSER_URL=http://localhost:8000
DOCLING_API_KEY=your_docling_api_key_here
DOCLING_TIMEOUT_MS=60000
